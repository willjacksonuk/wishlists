---
import { Button } from "@/components/starwind/button";
import { ThemeToggle } from "@/components/starwind/theme-toggle";

interface Props {
  title: string;
  titleHref?: string;
}

const { title, titleHref = "/" } = Astro.props;
const user = Astro.locals.user;
---

<header class="border-b border-border bg-background/80 backdrop-blur-sm sticky top-0 z-10">
  <div class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <a
      href={titleHref}
      class="text-xl font-medium text-muted-foreground tracking-wide truncate hover:text-foreground transition-colors"
      >{title}</a
    >
    <div class="flex items-center gap-2 shrink-0">
      {
        user ? (
          <>
            <Button variant="ghost" size="sm" href="/manage">Manage</Button>
            {user.isAdmin && (
              <Button variant="ghost" size="sm" href="/admin/users">Users</Button>
            )}
            <form method="post" action="/logout">
              <Button variant="ghost" size="sm" type="submit">Log out</Button>
            </form>
          </>
        ) : (
          <Button variant="outline" size="sm" href="/login">Log in</Button>
        )
      }
      <ThemeToggle />
    </div>
  </div>
</header>
