---
interface Props {
  username: string;
  password: string;
  message: string;
}

const { username, password, message } = Astro.props;
---

<div class="bg-card border border-blue-500/40 glow-blue rounded-md p-5 text-sm">
  <p class="mb-3">{message}</p>
  <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 font-mono">
    <dt class="text-muted-foreground">Username</dt><dd>{username}</dd>
    <dt class="text-muted-foreground">Password</dt><dd class="select-all">{password}</dd>
  </dl>
  <p class="mt-3 text-xs text-muted-foreground">This is the only time it's shown. They can change it in Settings after logging in.</p>
</div>
