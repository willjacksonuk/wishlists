---
import Page from "@/components/Page.astro";
import PageHero from "@/components/PageHero.astro";
import { directory } from "@/lib/wishlists";

const wishlists = directory();
---

<Page title="Wishlists">
  <PageHero title="Wishlists" subtitle="Pick a person to see what they'd like." />

  <section class="pb-16">
    {
      wishlists.length === 0 ? (
        <p class="text-center text-sm text-muted-foreground">No wishlists yet.</p>
      ) : (
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {wishlists.map((w) => (
            <li>
              <a
                href={`/${w.username}`}
                class="group flex items-center justify-between gap-4 bg-card border border-border rounded-md p-5 transition-all duration-200 hover:border-blue-500/40 hover:glow-blue"
              >
                <div class="min-w-0">
                  <h2 class="text-base font-semibold leading-snug text-foreground group-hover:text-primary-accent transition-colors truncate">
                    {w.displayName}
                  </h2>
                  <p class="text-xs text-muted-foreground truncate">{w.title}</p>
                </div>
                <span class="text-sm text-muted-foreground shrink-0">
                  {w.itemCount} {w.itemCount === 1 ? "item" : "items"}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</Page>
